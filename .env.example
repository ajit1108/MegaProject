# Environment Variables — copy to .env and fill in values
# Never commit .env to version control

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sensitive_data_detection

# For MongoDB Atlas, replace with your connection string:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# ── Tesseract OCR (Windows path example) ─────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Optional: External LLM (disabled by default) ─────────────
# OPENAI_API_KEY=sk-...
# EXTERNAL_AI_ENABLED=false
